  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && node --dns-result-order=ipv4first node_modules/expo/bin/cli start --go --android --localhost --port 8081",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-metro-worker-chunks.js",
    "test": "tsx --test src/data/fold.test.ts src/db/reads.test.ts src/db/favorites.test.ts src/auth/credentials.test.ts src/sync/conflict.test.ts src/vision/recognition.test.ts src/vision/evaluation.test.ts supabase/functions/identify-ingredients/handler.test.ts",
    "lint": "expo lint",
    "vision:preflight": "node --env-file-if-exists=supabase/functions/.env --import tsx scripts/vision-preflight.ts",
    "vision:evaluate": "node --env-file-if-exists=.env --env-file-if-exists=.env.vision.local --import tsx scripts/evaluate-vision.ts"
